rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is Admin or authenticated staff
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'surya11008@sni.org.in' ||
        request.auth.token.email == 'admin@sni.org.in' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Public Content (News, Announcements, Videos)
    match /announcements/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private Member Resources
    match /member_docs/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Dynamic Sub-pages Content (Articles, Resources, Circulars)
    match /page_contents/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dynamic Navigation Page Hierarchy
    match /portal_pages/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}