rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == '6NguI1ON0Dg95qeJNeXnbw2aRyX2';
    }

    function isValidVideo(data) {
      return data.keys().hasOnly(['title', 'category', 'videoUrl', 'coverUrl', 'createdAt'])
        && data.keys().hasAll(['title', 'category', 'videoUrl', 'coverUrl', 'createdAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 50
        && data.videoUrl is string
        && data.videoUrl.size() <= 2048
        && data.videoUrl.matches('https://.+')
        && data.coverUrl is string
        && data.coverUrl.size() <= 2048
        && (data.coverUrl == '' || data.coverUrl.matches('https://.+'));
    }

    match /artifacts/{appId}/public/data/schedules/{scheduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/{appId}/public/data/tableSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if isAdmin()
        && isValidVideo(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && isValidVideo(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
