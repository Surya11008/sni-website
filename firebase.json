{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/login",
        "destination": "/auth.html?mode=join",
        "type": 302
      },
      {
        "source": "/login.html",
        "destination": "/auth.html?mode=join",
        "type": 302
      },
      {
        "source": "/join",
        "destination": "/auth.html?mode=join",
        "type": 302
      },
      {
        "source": "/join.html",
        "destination": "/auth.html?mode=join",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}